# CQ6 — 연결/별도 비교: "삼성전자의 2024년 연결과 별도 매출액 차이는?"
# 두 값이 같은 회사·같은 재무제표에서 나오므로(CQ4와 같은 이유) scale 보정 없이 빼도 안전하다.
PREFIX dart: <http://dart-ontology.example.org/schema#>
PREFIX dart-data: <http://dart-ontology.example.org/data#>

SELECT ?consolidated ?separate ((?consolidated - ?separate) AS ?diff) WHERE {
  ?f1 a dart:XBRLFact ; dart:of dart-data:company_삼성전자 ; dart:about dart-data:metric_revenue ;
      dart:hasYear dart-data:year_2024 ; dart:hasScope dart-data:Consolidated ;
      dart:valueDecimal ?consolidated .
  ?f2 a dart:XBRLFact ; dart:of dart-data:company_삼성전자 ; dart:about dart-data:metric_revenue ;
      dart:hasYear dart-data:year_2024 ; dart:hasScope dart-data:Separate ;
      dart:valueDecimal ?separate .
}
LIMIT 1
