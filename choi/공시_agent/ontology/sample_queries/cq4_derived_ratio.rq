# CQ4 — 파생비율: "삼성전자의 2024년 부채비율은?"
# DerivationRule reification 덕에 공식(피연산자·배수)을 그래프 안에서 그대로 조회해 계산할 수
# 있다 — "부채비율"이라는 이름을 코드에 하드코딩하지 않고 그래프가 말해주는 공식을 따른다.
# 두 피연산자가 같은 회사·재무제표에서 나오므로(부채총계·자본총계 모두 BS_C) 같은 단위를
# 쓴다고 볼 수 있어 scale 보정 없이 나눠도 안전하다 — CQ2/CQ3(서로 다른 회사 비교)와 다른 점.
PREFIX dart: <http://dart-ontology.example.org/schema#>
PREFIX dart-data: <http://dart-ontology.example.org/data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ((?v1 / ?v2) * ?mult AS ?ratio) ?resultUnit ?reproductionRate WHERE {
  dart-data:rule_부채비율 dart:hasOperand1 ?op1 ; dart:hasOperand2 ?op2 ;
                          dart:multiplier ?mult ; dart:resultUnit ?resultUnit ;
                          dart:reproductionRate ?reproductionRate .
  ?op1 dart:normalizesTo ?m1 . ?op2 dart:normalizesTo ?m2 .

  ?f1 a dart:XBRLFact ; dart:of dart-data:company_삼성전자 ; dart:about ?m1 ;
      dart:hasScope dart-data:Consolidated ; dart:hasYear dart-data:year_2024 ; dart:valueDecimal ?v1 .
  ?f2 a dart:XBRLFact ; dart:of dart-data:company_삼성전자 ; dart:about ?m2 ;
      dart:hasScope dart-data:Consolidated ; dart:hasYear dart-data:year_2024 ; dart:valueDecimal ?v2 .
}
