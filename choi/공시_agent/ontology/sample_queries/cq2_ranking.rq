# CQ2 — 순위: "2024년 연결 자산총계 기준 상위 3개 기업은?"
# 주의: valueDecimal은 원문 표 셀의 숫자 그대로다(facts.py 설계 — 16번 함수 계약, "LLM은
# 문장화만, 값 선택·계산은 lookup_fact/compute가 담당"). 회사마다 표기 단위가 달라
# (삼성전자·KB금융·SK하이닉스는 '백만원'=scale 1,000,000, NAVER·대우건설은 '원'=scale 1)
# valueDecimal을 그대로 비교하면 순위가 완전히 틀어진다 — 반드시 scale을 곱해 원(KRW)
# 단위로 맞춘 뒤 비교해야 한다. GROUP BY로 회사당 값을 하나로 묶은 것은 같은 회사·연도의
# 값이 이후 보고서(비교연도 재기재)에서 중복 관측되기 때문이다(중복 제거).
PREFIX dart: <http://dart-ontology.example.org/schema#>
PREFIX dart-data: <http://dart-ontology.example.org/data#>

SELECT ?corpName (MAX(?valueKrw) AS ?totalAssetsKrw) WHERE {
  ?fact a dart:XBRLFact ;
        dart:of ?company ;
        dart:about dart-data:metric_total_assets ;
        dart:hasScope dart-data:Consolidated ;
        dart:hasYear dart-data:year_2024 ;
        dart:valueDecimal ?value ;
        dart:scale ?scale .
  BIND(?value * ?scale AS ?valueKrw)
  ?company dart:corpName ?corpName .
}
GROUP BY ?corpName
ORDER BY DESC(?totalAssetsKrw)
LIMIT 3
