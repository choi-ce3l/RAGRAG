# CQ1 — 단일조회: "삼성전자의 2024년 연결 매출액은 얼마인가?"
# DISTINCT인 이유: 같은 값이 2024년 사업보고서(당기)뿐 아니라 2025·2026년 사업보고서의
# 비교연도 컬럼에도 재기재되어 여러 fact로 중복 관측된다 — 값 자체는 동일하다.
PREFIX dart: <http://dart-ontology.example.org/schema#>
PREFIX dart-data: <http://dart-ontology.example.org/data#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?value ?unitKr WHERE {
  ?fact a dart:XBRLFact ;
        dart:of dart-data:company_삼성전자 ;
        dart:about dart-data:metric_revenue ;
        dart:hasScope dart-data:Consolidated ;
        dart:hasYear dart-data:year_2024 ;
        dart:valueDecimal ?value ;
        dart:unitKr ?unitKr .
}
