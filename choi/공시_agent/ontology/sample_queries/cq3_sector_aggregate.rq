# CQ3 — 업종 합계: "IT 업종 기업들의 2024년 연결 매출액 합계는?"
# 표본 5개사 중 industry='IT' 소속은 삼성전자·SK하이닉스뿐이다(sector_index.json 실측 —
# NAVER는 '커뮤니케이션서비스'로 분류돼 있어 여기 포함되지 않는다).
# CQ2와 같은 이유로 scale을 곱해 원(KRW) 단위로 맞춘 뒤 합산한다 — 이 두 회사는 우연히
# 둘 다 '백만원' 표기라 scale 보정 없이도 숫자상 맞아떨어지지만, 다른 업종에 이 쿼리를
# 재사용할 경우를 대비해 항상 scale을 곱하는 것이 맞다. 같은 값이 여러 문서(비교연도
# 재기재)에 중복 관측되므로 회사당 MAX로 한 번만 센다.
PREFIX dart: <http://dart-ontology.example.org/schema#>
PREFIX dart-data: <http://dart-ontology.example.org/data#>

SELECT (SUM(?revenueKrw) AS ?totalKrw) (COUNT(DISTINCT ?company) AS ?nCompanies) WHERE {
  {
    SELECT ?company (MAX(?value * ?scale) AS ?revenueKrw) WHERE {
      dart-data:sector_industry_IT dart:hasMember ?company .
      ?fact a dart:XBRLFact ;
            dart:of ?company ;
            dart:about dart-data:metric_revenue ;
            dart:hasScope dart-data:Consolidated ;
            dart:hasYear dart-data:year_2024 ;
            dart:valueDecimal ?value ;
            dart:scale ?scale .
    }
    GROUP BY ?company
  }
}
