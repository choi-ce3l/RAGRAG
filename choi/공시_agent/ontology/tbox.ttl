@prefix dart: <http://dart-ontology.example.org/schema#> .
@prefix dart-data: <http://dart-ontology.example.org/data#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dart:BalanceSheet a owl:Class ;
    rdfs:label "재무상태표"@ko ;
    rdfs:comment "facts.py _STATEMENT['BS']"@ko ;
    rdfs:subClassOf dart:Statement .

dart:CashFlowStatement a owl:Class ;
    rdfs:label "현금흐름표"@ko ;
    rdfs:comment "facts.py _STATEMENT['CF']"@ko ;
    rdfs:subClassOf dart:Statement .

dart:EquityStatement a owl:Class ;
    rdfs:label "자본변동표"@ko ;
    rdfs:comment "facts.py _STATEMENT['EF'] — kg.py STATEMENT_KO에는 누락돼 있던 값을 여기서 보완"@ko ;
    rdfs:subClassOf dart:Statement .

dart:ExchangeDisclosure a owl:Class ;
    rdfs:label "거래소공시(단일판매·공급계약 등)"@ko ;
    rdfs:comment "fields.py / field_ontology.json doc_group == 'exchange'"@ko ;
    rdfs:subClassOf dart:Document .

dart:HoldingReport a owl:Class ;
    rdfs:label "지분공시(대량보유상황보고서 등)"@ko ;
    rdfs:comment "fields.py / field_ontology.json doc_group == 'holding' (factx.jsonl 실측: holding 1,550,014건 — 3개 문서군 중 최다)"@ko ;
    rdfs:subClassOf dart:Document .

dart:IncomeStatement a owl:Class ;
    rdfs:label "손익계산서"@ko ;
    rdfs:comment "facts.py _STATEMENT['IS']"@ko ;
    rdfs:subClassOf dart:Statement .

dart:IndustryClass a owl:Class ;
    rdfs:label "산업(industry, 8종)"@ko ;
    rdfs:comment "sectors.py load()['industry'] — IT, 금융, 소재 등 GICS류 대분류"@ko ;
    rdfs:subClassOf dart:Sector .

dart:MajorMattersReport a owl:Class ;
    rdfs:label "주요사항보고서"@ko ;
    rdfs:comment "fields.py / field_ontology.json doc_group == 'major'"@ko ;
    rdfs:subClassOf dart:Document .

dart:PeriodicReport a owl:Class ;
    rdfs:label "정기공시(사업보고서 등)"@ko ;
    rdfs:comment "facts.py entry['doc_group'] == 'periodic'"@ko ;
    rdfs:subClassOf dart:Document .

dart:RatioStatement a owl:Class ;
    rdfs:label "재무비율(공시 명시값)"@ko ;
    rdfs:comment "derived.py validate()가 참조하는 statement=='ratio' 레코드 — 코퍼스에 명시된 비율값"@ko ;
    rdfs:subClassOf dart:Statement .

dart:SectorClass a owl:Class ;
    rdfs:label "업종(sector, 20종)"@ko ;
    rdfs:comment "sectors.py load()['sector'] — 반도체·전자부품, 자동차·모빌리티 등"@ko ;
    rdfs:subClassOf dart:Sector .

dart:about a owl:ObjectProperty ;
    rdfs:comment "facts.py metric_key/label_norm, factx field_key (kg.py ABOUT 엣지)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range dart:FinancialConcept .

dart:aclassXbrlCode a owl:DatatypeProperty ;
    rdfs:comment "facts.py aclass_xbrl_code"@ko ;
    rdfs:domain dart:XBRLFact ;
    rdfs:range xsd:string .

dart:anchorsPeriod a owl:ObjectProperty ;
    rdfs:comment "qa/eventspan.py — 이벤트 접수일자(filings.py meta[rn]['rcept_dt'])를 전/후 비교의 시간 기준점으로 삼는다"@ko ;
    rdfs:domain dart:Event ;
    rdfs:range dart:Period .

dart:canonicalLabel a owl:DatatypeProperty ;
    rdfs:comment "concepts.py canonical()"@ko ;
    rdfs:domain dart:AccountItem ;
    rdfs:range xsd:string .

dart:citedIn a owl:ObjectProperty ;
    rdfs:comment "facts.py rcept_no/doc_id (kg.py CITED_IN 엣지)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range dart:Document .

dart:colIndex a owl:DatatypeProperty ;
    rdfs:comment "facts.py col_index"@ko ;
    rdfs:domain dart:XBRLFact ;
    rdfs:range xsd:integer .

dart:contains a owl:ObjectProperty ;
    rdfs:comment "facts.py TABLE-GROUP → statement per 문서 (kg.py CONTAINS 엣지)"@ko ;
    rdfs:domain dart:Document ;
    rdfs:range dart:Statement .

dart:corpCode a owl:DatatypeProperty ;
    rdfs:comment "facts.py corp_code"@ko ;
    rdfs:domain dart:Company ;
    rdfs:range xsd:string .

dart:corpCoverage a owl:DatatypeProperty ;
    rdfs:comment "field_ontology.json corps"@ko ;
    rdfs:domain dart:StructuredField ;
    rdfs:range xsd:integer .

dart:corpName a owl:DatatypeProperty ;
    rdfs:comment "facts.py corp_name (rdfs:label과 별개로 원값 보존)"@ko ;
    rdfs:domain dart:Company ;
    rdfs:range xsd:string .

dart:coverageCount a owl:DatatypeProperty ;
    rdfs:comment "concepts.py ConceptIndex.corps[c] 크기(기업 수)"@ko ;
    rdfs:domain dart:AccountItem ;
    rdfs:range xsd:integer .

dart:docGroup a owl:DatatypeProperty ;
    rdfs:comment "factx.jsonl / field_ontology.json doc_group ('major'/'exchange'/'holding'/'periodic')"@ko ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dart:StructuredFact dart:StructuredField dart:Document ) ] ;
    rdfs:range xsd:string .

dart:docId a owl:DatatypeProperty ;
    rdfs:comment "facts.py doc_id"@ko ;
    rdfs:domain dart:Document ;
    rdfs:range xsd:string .

dart:docSubtype a owl:DatatypeProperty ;
    rdfs:comment "manifest doc_subtype"@ko ;
    rdfs:domain dart:Document ;
    rdfs:range xsd:string .

dart:eventTypeLabel a owl:DatatypeProperty ;
    rdfs:comment "qa/events_vocab.py event_types() 156종 통제 어휘 중 하나(정규화된 report_nm)"@ko ;
    rdfs:domain dart:Event ;
    rdfs:range xsd:string .

dart:factId a owl:DatatypeProperty ;
    rdfs:comment "facts.py fact_id"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:string .

dart:fieldKey a owl:DatatypeProperty ;
    rdfs:comment "factx.jsonl field_key"@ko ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( dart:StructuredFact dart:StructuredField ) ] ;
    rdfs:range xsd:string .

dart:filed a owl:ObjectProperty ;
    rdfs:comment "facts.py corp_code + rcept_no 조인 (kg.py FILED 엣지)"@ko ;
    rdfs:domain dart:Company ;
    rdfs:range dart:Document .

dart:fiscalTerm a owl:DatatypeProperty ;
    rdfs:comment "facts.py fiscal_term (제N기)"@ko ;
    rdfs:domain dart:Period ;
    rdfs:range xsd:integer .

dart:hasItem a owl:ObjectProperty ;
    rdfs:comment "concepts.py ConceptIndex.statements Counter (kg.py HAS_ITEM 엣지)"@ko ;
    rdfs:domain dart:Statement ;
    rdfs:range dart:AccountItem .

dart:hasOperand1 a owl:ObjectProperty ;
    rdfs:comment "derived.py RULES[name][1][0] (예: 부채비율의 '부채총계')"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range dart:AccountItem .

dart:hasOperand2 a owl:ObjectProperty ;
    rdfs:comment "derived.py RULES[name][1][1] (예: 부채비율의 '자본총계')"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range dart:AccountItem .

dart:hasPeriod a owl:ObjectProperty ;
    rdfs:comment "facts.py period_start/period_end/fiscal_term"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range dart:Period .

dart:hasRule a owl:ObjectProperty ;
    rdfs:comment "derived.py RULES — DerivedConcept 1개당 DerivationRule 1개(현재 스키마 기준 functional)"@ko ;
    rdfs:domain dart:DerivedConcept ;
    rdfs:range dart:DerivationRule .

dart:hasScope a owl:ObjectProperty ;
    rdfs:comment "facts.py scope (kg.py SCOPE 엣지)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range dart:Scope .

dart:hasYear a owl:ObjectProperty ;
    rdfs:comment "facts.py base_year (kg.py YEAR 엣지)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range dart:FiscalYear .

dart:isSuperseded a owl:DatatypeProperty ;
    rdfs:comment "facts.py is_superseded"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:boolean .

dart:kind a owl:DatatypeProperty ;
    rdfs:comment "field_ontology.json kind ('numeric'/'text')"@ko ;
    rdfs:domain dart:StructuredField ;
    rdfs:range xsd:string .

dart:matchCount a owl:DatatypeProperty ;
    rdfs:comment "derived_validation.json '일치'"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range xsd:integer .

dart:memberCount a owl:DatatypeProperty ;
    rdfs:comment "sectors.py members() 전체 크기(샘플로 축소되기 전 원본 규모)"@ko ;
    rdfs:domain dart:Sector ;
    rdfs:range xsd:integer .

dart:memberOf a owl:ObjectProperty ;
    rdfs:domain dart:Company ;
    rdfs:range dart:Sector ;
    owl:inverseOf dart:hasMember .

dart:metricKey a owl:DatatypeProperty ;
    rdfs:comment "facts.py _ONTOLOGY/_ONTOLOGY_EXT 키"@ko ;
    rdfs:domain dart:Metric ;
    rdfs:range xsd:string .

dart:mismatchCount a owl:DatatypeProperty ;
    rdfs:comment "derived_validation.json '불일치'"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range xsd:integer .

dart:missingOperandCount a owl:DatatypeProperty ;
    rdfs:comment "derived_validation.json '피연산자없음'"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range xsd:integer .

dart:multiplier a owl:DatatypeProperty ;
    rdfs:comment "derived.py RULES[name][3]"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range xsd:decimal .

dart:normalizesTo a owl:ObjectProperty ;
    rdfs:comment "concepts.py ConceptIndex.metric_of (kg.py NORMALIZES_TO 엣지)"@ko ;
    rdfs:domain dart:AccountItem ;
    rdfs:range dart:Metric .

dart:occurrenceCount a owl:DatatypeProperty ;
    rdfs:comment "field_ontology.json n"@ko ;
    rdfs:domain dart:StructuredField ;
    rdfs:range xsd:integer .

dart:of a owl:ObjectProperty ;
    rdfs:comment "facts.py corp_code (kg.py OF 엣지)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range dart:Company .

dart:operator a owl:DatatypeProperty ;
    rdfs:comment "derived.py RULES[name][0] ('÷')"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range xsd:string .

dart:parserConfidence a owl:DatatypeProperty ;
    rdfs:comment "facts.py parser_confidence"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:float .

dart:periodEnd a owl:DatatypeProperty ;
    rdfs:comment "facts.py period_end"@ko ;
    rdfs:domain dart:Period ;
    rdfs:range xsd:date .

dart:periodStart a owl:DatatypeProperty ;
    rdfs:comment "facts.py period_start"@ko ;
    rdfs:domain dart:Period ;
    rdfs:range xsd:date .

dart:rceptNo a owl:DatatypeProperty ;
    rdfs:comment "facts.py rcept_no"@ko ;
    rdfs:domain dart:Document ;
    rdfs:range xsd:string .

dart:reportNm a owl:DatatypeProperty ;
    rdfs:comment "manifest report_nm"@ko ;
    rdfs:domain dart:Document ;
    rdfs:range xsd:string .

dart:reproductionRate a owl:DatatypeProperty ;
    rdfs:comment "derived_validation.json 캐시값의 '재현율' — 재계산하지 않고 그대로 옮김"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range xsd:decimal .

dart:resultUnit a owl:DatatypeProperty ;
    rdfs:comment "derived.py RULES[name][2] ('%'/'회')"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range xsd:string .

dart:rowIndex a owl:DatatypeProperty ;
    rdfs:comment "facts.py row_index"@ko ;
    rdfs:domain dart:XBRLFact ;
    rdfs:range xsd:integer .

dart:scale a owl:DatatypeProperty ;
    rdfs:comment "facts.py scale (단위 배수)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:integer .

dart:sectorName a owl:DatatypeProperty ;
    rdfs:comment "sectors.py sector/industry 키"@ko ;
    rdfs:domain dart:Sector ;
    rdfs:range xsd:string .

dart:shape a owl:DatatypeProperty ;
    rdfs:comment "field_ontology.json shape ('ratio'/'count'/null)"@ko ;
    rdfs:domain dart:StructuredField ;
    rdfs:range xsd:string .

dart:sign a owl:DatatypeProperty ;
    rdfs:comment "facts.py sign (+1/-1)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:integer .

dart:supersededBy a owl:ObjectProperty ;
    rdfs:domain dart:Document ;
    rdfs:range dart:Document ;
    owl:inverseOf dart:supersedes .

dart:unit a owl:DatatypeProperty ;
    rdfs:comment "facts.py unit ('KRW')"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:string .

dart:unitKr a owl:DatatypeProperty ;
    rdfs:comment "facts.py unit_kr ('백만원' 등)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:string .

dart:validatesAgainstMetric a owl:ObjectProperty ;
    rdfs:comment "derived.py RULES[name][4] — non-null인 규칙에만 부여(부채비율→debt_ratio, 유동비율→current_ratio)"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range dart:Metric .

dart:validationStatus a owl:DatatypeProperty ;
    rdfs:comment "derived_validation.json '검증' 필드를 영문 enum(validated/failed/not_applicable)으로 정규화 — 한글 원값(됨/실패/불가)은 rdfs:comment로 보존"@ko ;
    rdfs:domain dart:DerivationRule ;
    rdfs:range xsd:string .

dart:valueDecimal a owl:DatatypeProperty ;
    rdfs:comment "facts.py value_decimal (Decimal 보존값)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:decimal .

dart:valueRaw a owl:DatatypeProperty ;
    rdfs:comment "facts.py value_raw (원문 표기)"@ko ;
    rdfs:domain dart:Fact ;
    rdfs:range xsd:string .

dart:yearValue a owl:DatatypeProperty ;
    rdfs:comment "facts.py base_year"@ko ;
    rdfs:domain dart:FiscalYear ;
    rdfs:range xsd:gYear .

dart-data:Consolidated a dart:Scope,
        owl:NamedIndividual ;
    skos:prefLabel "연결"@ko .

dart-data:Separate a dart:Scope,
        owl:NamedIndividual ;
    skos:prefLabel "별도"@ko .

dart:DerivedConcept a owl:Class ;
    rdfs:label "파생 개념(비율)"@ko ;
    rdfs:comment "choi/공시_agent/qa/derived.py RULES — 9개 파생비율(부채비율 등)"@ko ;
    rdfs:subClassOf dart:FinancialConcept .

dart:hasMember a owl:ObjectProperty ;
    rdfs:comment "sectors.py HAS_MEMBER 엣지 (kg.py schema_mermaid)"@ko ;
    rdfs:domain dart:Sector ;
    rdfs:range dart:Company .

dart:supersedes a owl:ObjectProperty ;
    rdfs:comment "qa/filings.py chain()/diff() — 정정본이 이전 문서를 대체한다. Fact.isSuperseded는 이 관계의 결과로 개별 수치에 찍히는 플래그다"@ko ;
    rdfs:domain dart:Document ;
    rdfs:range dart:Document .

dart:Event a owl:Class ;
    rdfs:label "이벤트 공시"@ko ;
    rdfs:comment "qa/events_vocab.py event_types() — report_nm이 156종 이벤트유형 어휘에 매칭되는 문서(정기공시 제외). qa/eventspan.py가 이 문서의 접수일자를 시간축 기준점 삼아 전후 Fact를 대조한다."@ko ;
    rdfs:subClassOf dart:Document .

dart:FiscalYear a owl:Class ;
    rdfs:label "회계연도"@ko ;
    rdfs:comment "facts.py Fact.base_year"@ko .

dart:StructuredFact a owl:Class ;
    rdfs:label "비-XBRL 구조화 사실"@ko ;
    rdfs:comment "factx.jsonl 레코드 — field_key/doc_group/kind 보유"@ko ;
    rdfs:subClassOf dart:Fact .

dart:Metric a owl:Class ;
    rdfs:label "정규 재무지표"@ko ;
    rdfs:comment "choi/code_chunkingandparsing/src/facts.py _ONTOLOGY(10) + ragrag/pipeline/facts.py _ONTOLOGY_EXT(21) = 31개 metric_key"@ko ;
    rdfs:subClassOf dart:FinancialConcept .

dart:Scope a owl:Class ;
    rdfs:label "연결/별도 기준"@ko ;
    rdfs:comment "facts.py Fact.scope ('consolidated'/'separate') — owl:oneOf로 정확히 두 개체만 허용"@ko ;
    owl:oneOf ( dart-data:Consolidated dart-data:Separate ) .

dart:XBRLFact a owl:Class ;
    rdfs:label "XBRL 재무제표 사실"@ko ;
    rdfs:comment "facts.py extract_facts() 반환 레코드 — aclass_xbrl_code/fiscal_term/row_index/col_index/sign 보유"@ko ;
    rdfs:subClassOf dart:Fact .

dart:FinancialConcept a owl:Class ;
    rdfs:label "재무 개념"@ko ;
    rdfs:comment "추상 최상위 — '수치/텍스트 질문의 대상이 될 수 있는 것'. 하위 4개 클래스로 세분."@ko .

dart:Period a owl:Class ;
    rdfs:label "회계기간"@ko ;
    rdfs:comment "facts.py Fact.period_start/period_end + qa/period.py 파싱 결과(기수 포함)"@ko .

dart:AccountItem a owl:Class ;
    rdfs:label "계정과목(정규형)"@ko ;
    rdfs:comment "choi/공시_agent/qa/concepts.py ConceptIndex — canonical(label_norm), surfaces, corps, synonym_group"@ko ;
    rdfs:subClassOf dart:FinancialConcept .

dart:Company a owl:Class ;
    rdfs:label "기업"@ko ;
    rdfs:comment "choi/code_chunkingandparsing/src/facts.py Fact.corp_code/corp_name"@ko .

dart:Sector a owl:Class ;
    rdfs:label "업종/산업"@ko ;
    rdfs:comment "choi/공시_agent/qa/sectors.py sector(20종)/industry(8종) 인덱스"@ko .

dart:StructuredField a owl:Class ;
    rdfs:label "비-XBRL 구조화 필드"@ko ;
    rdfs:comment "choi/공시_agent/qa/fields.py + data/field_ontology.json — 387개 (major/exchange/holding 문서군)"@ko ;
    rdfs:subClassOf dart:FinancialConcept .

dart:Statement a owl:Class ;
    rdfs:label "재무제표"@ko ;
    rdfs:comment "choi/code_chunkingandparsing/src/facts.py Fact.statement 필드 + derived.py 'ratio' 의사-제표"@ko .

dart:DerivationRule a owl:Class ;
    rdfs:label "파생 공식(n항관계 reification)"@ko ;
    rdfs:comment "derived.py RULES 튜플(연산자·피연산자2개·단위·배수·검증대상metric_key)을 W3C n-ary relation 패턴으로 reify — OWL 객체속성 하나로는 표현 불가능한 n항관계이므로"@ko .

dart:Document a owl:Class ;
    rdfs:label "공시문서"@ko ;
    rdfs:comment "choi/code_chunkingandparsing/src/facts.py Fact.rcept_no/doc_id, fields.py doctypes"@ko .

dart:Fact a owl:Class ;
    rdfs:label "사실(관측값)"@ko ;
    rdfs:comment "choi/code_chunkingandparsing/src/facts.py Fact 레코드 / structstore 구조화 fact 레코드"@ko .

